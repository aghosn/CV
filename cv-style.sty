\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cv-style}[2026/11/24 Editorial CV template]

\let\cv@variant\@empty
\DeclareOption{graphic}{\def\cv@variant{graphic}}
\DeclareOption{forest}{\def\cv@variant{forest}}
\ProcessOptions\relax

\RequirePackage{fix-cm}
\RequirePackage{fontspec}
\RequirePackage[a4paper,left=17mm,right=17mm,top=15mm,bottom=17mm,footskip=8mm]{geometry}
\RequirePackage{xcolor}
\RequirePackage{enumitem}
\RequirePackage{tabularx}
\RequirePackage{fancyhdr}
\RequirePackage{needspace}
\RequirePackage{microtype}
\RequirePackage{hyperref}

\setmainfont{texgyreheros}[
  Extension=.otf,
  UprightFont=*-regular,
  BoldFont=*-bold,
  ItalicFont=*-italic,
  BoldItalicFont=*-bolditalic
]

\definecolor{paper}{HTML}{FFFFFF}
\definecolor{ink}{HTML}{000000}
\colorlet{muted}{ink}
\definecolor{accent}{HTML}{246548}
\definecolor{line}{HTML}{D9E3D8}

\pagecolor{paper}
\color{ink}
\hypersetup{colorlinks=true,urlcolor=accent,linkcolor=accent,unicode=true}
\urlstyle{same}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\setlength{\tabcolsep}{0pt}
\setlength{\emergencystretch}{1em}
\AtBeginDocument{\fontsize{10.5}{13}\selectfont\raggedright}
\setlist[itemize]{
  leftmargin=12pt,label=\textcolor{accent}{\textbullet},
  topsep=3pt,itemsep=1pt,parsep=0pt,partopsep=0pt
}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0.4pt}
\renewcommand{\footrule}{\hbox to\headwidth{\color{line}\leaders\hrule height \footrulewidth\hfill}}
\fancyfoot[R]{\fontsize{8}{10}\selectfont\color{muted}\thepage\ / \pageref*{cv:lastpage}}

\newcommand{\cvfooter}[2]{%
  \fancyfoot[L]{\fontsize{8}{10}\selectfont\color{muted}#1}%
  \fancyfoot[C]{\fontsize{8}{10}\selectfont\color{muted}#2}%
}

\newcommand{\cvcontactsep}{\quad{\color{line}\textbar}\quad}

\newcommand{\cvheader}[4]{%
  \gdef\cvname{#1}%
  {\fontsize{36}{39}\selectfont\bfseries #1\par}%
  \vspace{5pt}%
  {\fontsize{11.5}{14}\selectfont\color{accent}#2%
   \hfill{\fontsize{9.5}{12}\selectfont\color{muted}#3}\par}%
  \vspace{6pt}%
  {\fontsize{9}{11}\selectfont #4\par}%
  \vspace{10pt}%
  {\color{accent}\hrule height 0.8pt}%
}

\newcommand{\cvsummary}[2]{%
  \par\addvspace{11pt}%
  {\fontsize{12}{15}\selectfont\bfseries #1\par}%
  \vspace{4pt}%
  #2\par
}

\newcommand{\cvcontinuation}[1]{%
  {\fontsize{11}{14}\selectfont\bfseries\cvname
   \hfill\mdseries\color{muted}#1\par}%
}

\newcommand{\cvsection}[1]{%
  \par\addvspace{16pt}%
  \Needspace{60pt}%
  {\fontsize{15}{18}\selectfont\bfseries\color{accent}%
   #1\hspace{10pt}%
   {\color{line}\leaders\hbox{\rule[4pt]{1pt}{0.5pt}}\hfill\kern0pt}\par}%
  \vspace{8pt}%
}

\newcommand{\cvdaterange}[2]{#1--\allowbreak#2}
\newcommand{\cvdateseparator}{ / }

\newcommand{\cventry}[5]{%
  \par\addvspace{10pt}%
  \Needspace{52pt}%
  {\bfseries #2}\hfill{\fontsize{9}{11}\selectfont\color{muted}#4}\par
  {#1}\hfill{\fontsize{9}{11}\selectfont\color{muted}#3}\par
  \vspace{2pt}%
  #5\par
}

\newcommand{\cvemployer}[1]{%
  \par\addvspace{10pt}%
  \Needspace{80pt}%
  {\fontsize{11}{13}\selectfont\bfseries #1\par}%
}

\newcommand{\cvposition}[4]{\cventry{}{\textcolor{accent}{#1}}{#2}{#3}{#4}}

\newcommand{\cvskill}[2]{%
  \par\addvspace{3pt}%
  \begin{tabularx}{\textwidth}{@{}p{23mm}@{\hspace{3mm}}>{\raggedright\arraybackslash}X@{}}%
    {\bfseries #1} & #2%
  \end{tabularx}\par
}

\newcommand{\cvpublication}[5]{%
  \par\addvspace{10pt}%
  \begin{minipage}[t]{12mm}%
    \fontsize{10}{12}\selectfont\color{muted}#1%
  \end{minipage}%
  \begin{minipage}[t]{\dimexpr\textwidth-12mm\relax}%
    \raggedright
    {\bfseries\href{#3}{\textcolor{ink}{#4}}\par}%
    {\fontsize{8.7}{10.5}\selectfont\color{muted}#5\par}%
    \vspace{1pt}%
    {\fontsize{8}{10}\selectfont\color{muted}#2\par}%
  \end{minipage}\par
}

\newcommand{\cvself}[1]{\textbf{#1}}

\newcommand{\cvnote}[1]{%
  \par\addvspace{8pt}%
  {\fontsize{9}{11}\selectfont\color{muted}#1\par}%
}

\ifx\cv@variant\@empty
\else
  \RequirePackage{cv-style-\cv@variant}
\fi
